{% doc %}
  @prompt
    Create a clean, minimalist 4-column footer section for my theme using Liquid and CSS. 
    
    Design Specifications:
    - Layout: 4 equal-width columns arranged horizontally in a row with generous spacing (flexbox or CSS grid).
    - Typography: Clean sans-serif font, subtle dark gray/black text on a clean white background. Title headings should have slightly larger margin-bottom.
    - Style: Minimalist fashion brand style, left-aligned text, no bullet points, no border lines, clean vertical list of links under each column.
    
    Columns & Links Content:
    1. Column 1 Header: "Shop"
       Links: Search, Womenswear, Menswear, Sale
    
    2. Column 2 Header: "Customer care"
       Links: FAQ, Fit guide, Contact us
    
    3. Column 3 Header: "About us"
       Links: Our story, Blog, Materials & care
    
    4. Column 4 Header: "Connect"
       Links: Instagram, TikTok, Youtube, Facebook
    
    Make sure each link group connects dynamically to Shopify navigation menus if possible, and ensure the section is fully responsive (stacking into 1 or 2 columns on mobile devices).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-columns-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-footer-columns__container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
  }

  /* Exact 4-column grid layout with equal 1fr proportions */
  .ai-footer-columns__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: {{ block.settings.column_spacing }}px;
    row-gap: 30px;
    width: 100%;
  }

  .ai-footer-columns__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .ai-footer-columns__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
    text-transform: {{ block.settings.heading_text_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: 1.2;
  }

  .ai-footer-columns__links-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
  }

  .ai-footer-columns__link-{{ ai_gen_id }} {
    font-family: {{ block.settings.link_font.family }}, {{ block.settings.link_font.fallback_families }};
    font-weight: {{ block.settings.link_font.weight }};
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-block;
    line-height: 1.3;
  }

  .ai-footer-columns__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-footer-columns__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 30px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-footer-columns__container-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-footer-columns__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-footer-columns__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.95 }}px;
    }

    .ai-footer-columns__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.link_size }}px;
    }
  }
{% endstyle %}

<footer-columns-{{ ai_gen_id }} class="ai-footer-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-columns__container-{{ ai_gen_id }}">
    <div class="ai-footer-columns__grid-{{ ai_gen_id }}">
      
      <!-- Column 1 -->
      <div class="ai-footer-columns__column-{{ ai_gen_id }}">
        <h3 class="ai-footer-columns__heading-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h3>
        <ul class="ai-footer-columns__links-{{ ai_gen_id }}">
          {% if block.settings.menu_1 != blank %}
            {% for link in block.settings.menu_1.links %}
              <li><a href="{{ link.url }}" class="ai-footer-columns__link-{{ ai_gen_id }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Search</a></li>
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Womenswear</a></li>
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Menswear</a></li>
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Sale</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 2 -->
      <div class="ai-footer-columns__column-{{ ai_gen_id }}">
        <h3 class="ai-footer-columns__heading-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h3>
        <ul class="ai-footer-columns__links-{{ ai_gen_id }}">
          {% if block.settings.menu_2 != blank %}
            {% for link in block.settings.menu_2.links %}
              <li><a href="{{ link.url }}" class="ai-footer-columns__link-{{ ai_gen_id }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">FAQ</a></li>
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Fit guide</a></li>
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Contact us</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 3 -->
      <div class="ai-footer-columns__column-{{ ai_gen_id }}">
        <h3 class="ai-footer-columns__heading-{{ ai_gen_id }}">{{ block.settings.heading_3 }}</h3>
        <ul class="ai-footer-columns__links-{{ ai_gen_id }}">
          {% if block.settings.menu_3 != blank %}
            {% for link in block.settings.menu_3.links %}
              <li><a href="{{ link.url }}" class="ai-footer-columns__link-{{ ai_gen_id }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Our story</a></li>
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Blog</a></li>
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Materials & care</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 4 -->
      <div class="ai-footer-columns__column-{{ ai_gen_id }}">
        <h3 class="ai-footer-columns__heading-{{ ai_gen_id }}">{{ block.settings.heading_4 }}</h3>
        <ul class="ai-footer-columns__links-{{ ai_gen_id }}">
          {% if block.settings.menu_4 != blank %}
            {% for link in block.settings.menu_4.links %}
              <li><a href="{{ link.url }}" class="ai-footer-columns__link-{{ ai_gen_id }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Instagram</a></li>
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">TikTok</a></li>
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Youtube</a></li>
            <li><a href="#" class="ai-footer-columns__link-{{ ai_gen_id }}">Facebook</a></li>
          {% endif %}
        </ul>
      </div>

    </div>
  </div>
</footer-columns-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterColumns{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('footer-columns-{{ ai_gen_id }}', FooterColumns{{ ai_gen_id }});
  })();
</script>

