{%- doc -%}
  Logo row / carousel from a card_content metaobject list.
  Each entry shows only an image or icon — no text.

  @param {block} block - The block object
{%- enddoc -%}

{%- liquid
  assign s              = block.settings
  assign metaobject_list = s.metaobject_list
  assign desktop_layout  = s.desktop_layout
  assign columns         = s.columns
  assign mobile_columns  = s.mobile_columns
  assign gap             = s.gap
  assign logo_size       = s.logo_size
  assign card_padding    = s.card_padding
  assign border_style    = s.border_style
  assign border_radius   = s.border_radius
  assign bg_color        = s.card_background
  assign h_align         = s.horizontal_alignment
  assign v_align         = s.vertical_alignment
  assign inherit_color   = s.inherit_color_scheme
-%}

<div
  class="cmo spacing-style{% if inherit_color %} color-inherit{% endif %}"
  style="
    {% render 'spacing-style', settings: s %}
    --cmo-gap: {{ gap }}px;
    --cmo-columns: {{ columns }};
    --cmo-mobile-columns: {{ mobile_columns }};
  "
  {{ block.shopify_attributes }}
>
  {%- if metaobject_list != blank -%}

    {%- if desktop_layout == 'carousel' -%}

      <div class="cmo__carousel-wrap">
        <div class="cmo__track">
          {%- for entry in metaobject_list -%}
            {%- render 'carousel-metaobject-card',
              entry: entry,
              border_style: border_style,
              border_radius: border_radius,
              logo_size: logo_size,
              card_padding: card_padding,
              bg_color: bg_color,
              h_align: h_align,
              v_align: v_align
            -%}
          {%- endfor -%}
        </div>

        <div class="cmo__nav" aria-label="Carousel navigation">
          <button class="cmo__arrow cmo__arrow--prev" aria-label="Previous" type="button">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12.5 15L7.5 10l5-5"/></svg>
          </button>
          <button class="cmo__arrow cmo__arrow--next" aria-label="Next" type="button">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7.5 5l5 5-5 5"/></svg>
          </button>
        </div>
      </div>

    {%- else -%}

      <div class="cmo__grid">
        {%- for entry in metaobject_list -%}
          {%- render 'carousel-metaobject-card',
            entry: entry,
            border_style: border_style,
            border_radius: border_radius,
            logo_size: logo_size,
            card_padding: card_padding,
            bg_color: bg_color,
            h_align: h_align,
            v_align: v_align
          -%}
        {%- endfor -%}
      </div>

    {%- endif -%}

  {%- else -%}
    <div class="cmo__empty">
      <p>Select a metaobject list, or create a <strong>card_content</strong> definition first.</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}

/* ── Outer wrapper ─────────────────────────────── */
.cmo { width: 100%; }

/* ── Grid ──────────────────────────────────────── */
.cmo__grid {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--cmo-gap, 8px);
}

/* ── Carousel track ────────────────────────────── */
.cmo__carousel-wrap { position: relative; }

.cmo__track {
  display: flex;
  align-items: center;
  gap: var(--cmo-gap, 8px);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.cmo__track::-webkit-scrollbar { display: none; }

/* ── Logo card ─────────────────────────────────── */
.cmo__logo-card {
  /* flex child inside track / grid */
  flex: 0 0 auto;
  scroll-snap-align: start;

  /* internal layout: centre the logo */
  display: flex;
  align-items: var(--cmo-v-align, center);
  justify-content: var(--cmo-h-align, center);
  padding: var(--cmo-card-pad, 8px);
  border-radius: var(--cmo-card-radius, 0px);
  background-color: transparent;
  overflow: hidden;
  transition: opacity 0.2s ease;
}

.cmo__logo-card:hover { opacity: 0.75; }

.cmo__logo-card--border {
  border: 1px solid var(--color-border, rgba(0,0,0,0.12));
}

/* ── Logo image ────────────────────────────────── */
.cmo__logo-img {
  display: block;
  width: auto;
  height: var(--cmo-logo-size, 32px);
  max-width: 100%;
  object-fit: contain;
  object-position: center;
  /* prevent browser from stretching transparent SVGs */
  flex-shrink: 0;
}

/* ── Icon fallback ─────────────────────────────── */
.cmo__logo-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 0;
}

.cmo__logo-icon svg,
.cmo__logo-icon .payment-icon {
  display: block;
  width: auto;
  height: var(--cmo-logo-size, 32px);
  max-width: none;
}

/* ── Arrow navigation ──────────────────────────── */
.cmo__nav {
  display: flex;
  justify-content: space-between;
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  pointer-events: none;
  z-index: 2;
}

.cmo__arrow {
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: 999px;
  border: 1px solid rgba(0,0,0,0.15);
  background: var(--color-background, #fff);
  color: var(--color-foreground, #111);
  cursor: pointer;
  transition: background 0.15s ease, opacity 0.15s;
}

.cmo__arrow:hover {
  background: var(--color-foreground, #111);
  color: var(--color-background, #fff);
}

.cmo__arrow[disabled] { opacity: 0.25; cursor: default; }
.cmo__arrow--prev { transform: translateX(-50%); }
.cmo__arrow--next { transform: translateX(50%); }

/* ── Empty state ───────────────────────────────── */
.cmo__empty {
  padding: 1.5rem;
  text-align: center;
  border: 2px dashed rgba(0,0,0,0.1);
  border-radius: 8px;
  font-size: 0.875rem;
  color: var(--color-foreground-muted, var(--color-foreground));
}

{% endstylesheet %}

<script>
(function () {
  'use strict';

  var wraps = document.querySelectorAll('.cmo__carousel-wrap');
  wraps.forEach(function (wrap) {
    var track = wrap.querySelector('.cmo__track');
    var prev  = wrap.querySelector('.cmo__arrow--prev');
    var next  = wrap.querySelector('.cmo__arrow--next');
    if (!track || !prev || !next) return;

    function sync() {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    }

    prev.addEventListener('click', function () {
      track.scrollBy({ left: -(track.clientWidth * 0.75), behavior: 'smooth' });
    });
    next.addEventListener('click', function () {
      track.scrollBy({ left: track.clientWidth * 0.75, behavior: 'smooth' });
    });

    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
    sync();
  });
})();
</script>

{% schema %}
{
  "name": "Logo Row (Metaobject)",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Source"
    },
    {
      "type": "metaobject_list",
      "id": "metaobject_list",
      "label": "Metaobject list",
      "metaobject_type": "card_content",
      "info": "Requires a card_content metaobject definition with image and icon_name fields."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel (scrollable)" },
        { "value": "grid",     "label": "Wrap (flex wrap)"      }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Visible columns (desktop)",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Visible columns (mobile)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo height",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between logos",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Alignment"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "options": [
        { "value": "flex-start", "label": "Left"   },
        { "value": "center",     "label": "Center" },
        { "value": "flex-end",   "label": "Right"  }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "flex-start", "label": "Top"    },
        { "value": "center",     "label": "Center" },
        { "value": "flex-end",   "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Card appearance"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "placeholder": "Transparent"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border",
      "options": [
        { "value": "none",  "label": "None"  },
        { "value": "solid", "label": "Solid" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "Inherit color scheme",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    }
  ],
  "presets": [
    {
      "name": "Logo Row (Metaobject)",
      "category": "Media",
      "settings": {
        "desktop_layout":       "carousel",
        "columns":              6,
        "mobile_columns":       4,
        "logo_size":            32,
        "card_padding":         8,
        "gap":                  8,
        "horizontal_alignment": "center",
        "vertical_alignment":   "center",
        "border_style":         "none",
        "border_radius":        4
      }
    }
  ]
}
{% endschema %}
