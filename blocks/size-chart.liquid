{%- liquid
  assign product = closest.product | default: product
  assign collection = closest.collection | default: collection

  assign chart = nil
  if product.metafields.custom.size_chart.value != blank
    assign chart = product.metafields.custom.size_chart.value
  elsif collection.metafields.custom.default_size_chart.value != blank
    assign chart = collection.metafields.custom.default_size_chart.value
  elsif product != blank
    for col in product.collections
      if col.metafields.custom.default_size_chart.value != blank
        assign chart = col.metafields.custom.default_size_chart.value
        break
      endif
    endfor
  endif
-%}

{%- if chart != blank and chart.rows.value.size > 0 -%}
  <div class="block-size-chart" {{ block.shopify_attributes }}>
    {% render 'size-chart', chart: chart, product: product, collection: collection, block: block %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Size Chart",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Size guide"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Font Color",
      "default": "#111111"
    },
    {
      "type": "checkbox",
      "id": "show_ruler_icon",
      "label": "Show Ruler Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_guide_image",
      "label": "Show Guide Image",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Size Chart"
    }
  ]
}
{% endschema %}
