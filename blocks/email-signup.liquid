{% assign block_settings = block.settings %}
{% liquid
  assign is_custom_input = false
  if block_settings.input_style == 'custom'
    assign is_custom_input = true
  endif
%}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}
<div
  class="email-signup-block size-style spacing-style"
  style="
    {% render 'size-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
  "
  {{ block.shopify_attributes }}
>
  {% if block_settings.heading != blank %}
    <div
      class="email-signup__heading {{ block_settings.heading_preset }}"
      style="{% if block_settings.heading_text_color != blank %}--color: {{ block_settings.heading_text_color }}; --color-rgb: {{ block_settings.heading_text_color.rgb }};{% endif %}"
    >
      {{ block_settings.heading | escape }}
    </div>
  {% endif %}
  
  {% assign form_id = 'ContactFooter-' | append: block.id %}
  
  {%- comment -%} 
    Membuka form murni tanpa skrip AJAX tema, sehingga jika hCaptcha muncul, 
    browser bisa memproses redirect sukses dengan sempurna.
  {%- endcomment -%}
  {%- form 'customer', id: form_id, class: 'email-signup__form spacing-style' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="hidden" name="contact[note]" value="Footer Newsletter">
    
    {%- liquid
      assign input_group_classes = 'email-signup__input-group'
      if block_settings.integrated_button and block_settings.border_style != 'underline'
        assign input_group_classes = input_group_classes | append: ' email-signup__input-group--integrated'
      endif
      if block_settings.border_style == 'underline'
        assign input_group_classes = input_group_classes | append: ' email-signup__input-group--underline'
      endif
      if block_settings.border_style == 'none'
        assign input_group_classes = input_group_classes | append: ' email-signup__input-group--no-border'
      endif
      if block_settings.display_type == 'arrow'
        assign input_group_classes = input_group_classes | append: ' email-signup__input-group--arrow'
      endif
    -%}

    {%- unless form.posted_successfully? -%}
    <div
      class="{{ input_group_classes }}"
      style="
        --border-width: {% if is_custom_input %}{{ block_settings.border_width }}px{% else %}var(--style-border-width-inputs){% endif %};
        --border-radius: {% if is_custom_input %}{{ block_settings.border_radius }}px{% else %}var(--style-border-radius-inputs){% endif %};
        {% if is_custom_input %}{% render 'input-custom-styles', block_settings: block_settings %}{% endif %}
      "
    >
      <label for="EmailInput-{{ block.id }}" class="visually-hidden">
        {{ 'blocks.email_signup.label' | t }}
      </label>
      <input
        id="EmailInput-{{ block.id }}"
        class="email-signup__input email-signup__input--{{ block_settings.border_style }} {% if is_custom_input %}{{ block_settings.input_type_preset }}{% else %}{{ settings.type_preset }}{% endif %} {{ block_settings.border_variation }}"
        type="email"
        name="contact[email]"
        autocorrect="off"
        autocapitalize="off"
        autocomplete="email"
        placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
        required
        {% if form.errors %}
          autofocus
          aria-invalid="true"
          aria-describedby="Email-signup__message-error-{{ block.id }}"
        {% endif %}
      >
      <button
        type="submit"
        class="email-signup__button {% if block_settings.integrated_button or block_settings.border_style == 'underline' %}email-signup__button--integrated{% endif %} email-signup__button--{{ block_settings.display_type }} {{ block_settings.button_type_preset }} {{ block_settings.style_class }} {{ block_settings.style_class }}--{{ block.id }}"
        {% if block_settings.display_type != 'text' %}
          aria-label="{{ 'actions.sign_up' | t }}"
        {% endif %}
      >
        {% if block_settings.display_type == 'text' %}
          {{ block_settings.label }}
        {% else %}
          <svg viewBox="0 0 20 20" xmlns="http://w3.org" focusable="false" aria-hidden="true" class="email-signup__button-icon">
            {% render 'icon', icon: 'arrow' %}
          </svg>
        {% endif %}
      </button>
    </div>
    {%- endunless -%}

    {%- if form.errors -%}
      <div id="Email-signup__message-error-{{ block.id }}" class="email-signup__message" tabindex="-1">
        <svg viewBox="0 0 20 20" xmlns="http://w3.org" focusable="false" aria-hidden="true" class="icon-error">
          {%- render 'icon', icon: 'error'  -%}
        </svg>
        {{- form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div id="Email-signup__message-success-{{ block.id }}" class="email-signup__message" tabindex="-1">
        <span class="svg-wrapper icon-success">
          {{ 'icon-checkmark.svg' | inline_asset_content }}
        </span>
        <p class="email-signup__message-text">{{ 'blocks.email_signup.success' | t }}</p>
      </div>
    {%- endif -%}
  {% endform %}
</div>

{%- comment -%}
  PENTING: Seluruh tag <script> lama yang berisi fungsi `fetch` dan `e.preventDefault()` 
  telah DIHAPUS TOTAL dari sini agar tidak membekukan halaman setelah pengisian captcha.
{%- endcomment -%}

