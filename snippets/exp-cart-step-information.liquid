{%- comment -%}
  Renders Step 1: Recipient Information
  Params:
    - heading_tag: string (h1-h6, p)
    - default_first_name: string
    - default_last_name: string
    - default_email: string
    - default_phone: string
    - phone_prefix: string
{%- endcomment -%}

{%- assign heading_tag = heading_tag | default: 'h3' -%}
{%- assign phone_prefix = phone_prefix | default: '+62' -%}

<div class="exp-step-content" data-step="1">
  <div class="exp-step-header">
    <div class="exp-step-header__title-row">
      <{{ heading_tag }} class="exp-step-title">{{ step_1_heading | default: 'Recipient Information' }}</{{ heading_tag }}>
      <span class="exp-address-mode-badge hidden" id="exp-address-mode-badge" aria-live="polite">
        <span class="exp-mode-badge-dot" aria-hidden="true"></span>
        <span class="exp-mode-badge-text">{{ badge_new_address_text | default: 'Mode Alamat Baru' }}</span>
      </span>
    </div>
    <div class="exp-autofill-hint hidden" id="exp-autofill-hint">
      <span>{{ autofill_hint_text | default: '💡 Membuat alamat baru. Ingin gunakan kontak akun Anda?' }}</span>
      <button type="button" class="exp-btn-inline-autofill" id="exp-btn-fill-my-contact">
        {{ btn_fill_contact_text | default: '👤 Gunakan Kontak Saya' }}
      </button>
    </div>
  </div>

  <div class="exp-form-grid">
    {%- comment -%} First Name {%- endcomment -%}
    <div class="exp-field-group">
      <label for="exp-first-name" class="exp-label">
        First Name <span class="exp-required" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="exp-first-name"
        name="firstName"
        class="exp-input"
        placeholder="John"
        value="{{ default_first_name | escape }}"
        required
        autocomplete="given-name"
      >
      <span class="exp-field-error" aria-live="polite">First name wajib diisi.</span>
    </div>

    {%- comment -%} Last Name {%- endcomment -%}
    <div class="exp-field-group">
      <label for="exp-last-name" class="exp-label">
        Last Name <span class="exp-required" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="exp-last-name"
        name="lastName"
        class="exp-input"
        placeholder="Doe"
        value="{{ default_last_name | escape }}"
        required
        autocomplete="family-name"
      >
      <span class="exp-field-error" aria-live="polite">Last name wajib diisi.</span>
    </div>

    {%- comment -%} Email {%- endcomment -%}
    <div class="exp-field-group">
      <label for="exp-email" class="exp-label">
        Email <span class="exp-required" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="exp-email"
        name="email"
        class="exp-input"
        placeholder="e.g johndoe@gmail.com"
        value="{{ default_email | escape }}"
        required
        autocomplete="email"
      >
      <span class="exp-field-error" aria-live="polite">Format email tidak valid.</span>
    </div>

    {%- comment -%} Phone Number {%- endcomment -%}
    <div class="exp-field-group">
      <label for="exp-phone" class="exp-label">
        Phone Number <span class="exp-required" aria-hidden="true">*</span>
      </label>
      <div class="exp-phone-wrapper">
        <span class="exp-phone-prefix" aria-label="Country code">
          <span class="exp-phone-flag" aria-hidden="true">🇮🇩</span>
          <span class="exp-phone-code">{{ phone_prefix }}</span>
        </span>
        <input
          type="tel"
          id="exp-phone"
          name="phone"
          class="exp-input exp-phone-input"
          placeholder="81234567890"
          value="{{ default_phone | replace: '+62', '' | replace: '^0+', '' | escape }}"
          required
          inputmode="numeric"
          autocomplete="tel-national"
        >
      </div>
      <span class="exp-field-error" aria-live="polite">Nomor telepon wajib diisi.</span>
    </div>
  </div>

  <div class="exp-step-actions exp-step-actions--single">
    <button type="button" class="exp-btn exp-btn--primary exp-btn-next">
      <span>{{ step_1_btn_text | default: 'Next' }}</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</div>
