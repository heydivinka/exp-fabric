{%- doc -%}
  Renders a single logo card from a card_content metaobject entry.
  Shows image if available, otherwise falls back to icon via exp-custom-icons.
  No text is rendered — logo/icon only.

  @param {object} entry          - The metaobject entry (card_content type)
  @param {string} border_style   - "none" | "solid"
  @param {number} border_radius  - Corner radius in px
  @param {number} logo_size      - Max logo height in px
  @param {number} card_padding   - Internal padding in px
  @param {string} bg_color       - Optional card background color
  @param {string} h_align        - Horizontal alignment: flex-start | center | flex-end
  @param {string} v_align        - Vertical alignment: flex-start | center | flex-end
{%- enddoc -%}

{%- liquid
  assign display_name = entry.display_name.value
  assign img_file     = entry.image.value
  assign icon_name    = entry.icon_name.value
  assign icon_key     = icon_name | strip | downcase

  assign border_class = ''
  if border_style == 'solid'
    assign border_class = ' cmo__logo-card--border'
  endif
-%}

<div
  class="cmo__logo-card{{ border_class }}"
  style="
    --cmo-logo-size: {{ logo_size }}px;
    --cmo-card-pad: {{ card_padding }}px;
    --cmo-card-radius: {{ border_radius }}px;
    --cmo-h-align: {{ h_align }};
    --cmo-v-align: {{ v_align }};
    {% if bg_color != blank %}background-color: {{ bg_color }};{% endif %}
  "
>
  {%- if img_file != blank -%}
    {%- assign logo_size_str = logo_size | append: 'px' -%}
    {{-
      img_file
      | image_url: width: 300
      | image_tag:
        class: 'cmo__logo-img',
        widths: '80,120,160,240,300',
        sizes: logo_size_str,
        loading: 'lazy',
        alt: display_name | default: '' | escape
    -}}
  {%- elsif icon_key != blank -%}
    {%- assign icon_param = icon_key -%}
    <span class="cmo__logo-icon">
      {%- render 'exp-custom-icons', icon: icon_param -%}
    </span>
  {%- endif -%}
</div>
