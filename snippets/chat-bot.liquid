{%- comment -%}
  chat-bot.liquid
  Custom CS chatbot widget — multi-language, FAQ-based bot.
  Rendered once in layout/theme.liquid
{%- endcomment -%}

{%- liquid
  assign locale = request.locale.iso_code | downcase | slice: 0, 2
  assign supported = 'en,id,fr,de,es,ja' | split: ','
  unless supported contains locale
    assign locale = 'en'
  endunless
-%}

{%- comment -%} ── FAB toggle button ── {%- endcomment -%}
<button
  id="cb-toggle"
  class="cb-fab"
  aria-label="Open customer support chat"
  aria-expanded="false"
  aria-controls="cb-panel"
>
  <span class="cb-fab__icon cb-fab__icon--chat" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
  </span>
  <span class="cb-fab__icon cb-fab__icon--close" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M1 1l16 16M17 1L1 17"/>
    </svg>
  </span>
  <span id="cb-badge" class="cb-badge cb-hidden" aria-hidden="true">1</span>
</button>

{%- comment -%} ── Chat panel ── {%- endcomment -%}
<div id="cb-widget" role="complementary" aria-label="Customer support chat">
  <div id="cb-panel" class="cb-panel cb-panel--closed" role="dialog" aria-modal="false" aria-labelledby="cb-title">

    {%- comment -%} Header {%- endcomment -%}
    <div class="cb-header">
      <div class="cb-header__info">
        <div class="cb-avatar" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
          </svg>
        </div>
        <div>
          <p id="cb-title" class="cb-header__title">Customer Support</p>
          <p id="cb-subtitle" class="cb-header__subtitle">Typically replies instantly</p>
        </div>
      </div>
      <div class="cb-header__actions">
        <div class="cb-lang-wrap">
          <label for="cb-lang" class="cb-sr-only">Language</label>
          <select id="cb-lang" class="cb-lang-select" aria-label="Select language">
            <option value="en" {% if locale == 'en' %}selected{% endif %}>🇬🇧 EN</option>
            <option value="id" {% if locale == 'id' %}selected{% endif %}>🇮🇩 ID</option>
            <option value="fr" {% if locale == 'fr' %}selected{% endif %}>🇫🇷 FR</option>
            <option value="de" {% if locale == 'de' %}selected{% endif %}>🇩🇪 DE</option>
            <option value="es" {% if locale == 'es' %}selected{% endif %}>🇪🇸 ES</option>
            <option value="ja" {% if locale == 'ja' %}selected{% endif %}>🇯🇵 JA</option>
          </select>
        </div>
        <button id="cb-close" class="cb-icon-btn" aria-label="Close chat">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 1l14 14M15 1L1 15"/>
          </svg>
        </button>
      </div>
    </div>

    {%- comment -%} Messages area {%- endcomment -%}
    <div id="cb-messages" class="cb-messages" role="log" aria-live="polite" aria-label="Chat messages"></div>

    {%- comment -%} Quick replies {%- endcomment -%}
    <div id="cb-quick-replies" class="cb-quick-replies" aria-label="Quick reply options"></div>

    {%- comment -%} Input row {%- endcomment -%}
    <div class="cb-input-row">
      <input
        id="cb-input"
        type="text"
        class="cb-input"
        placeholder="Type a message…"
        autocomplete="off"
        maxlength="300"
        aria-label="Message input"
      >
      <button id="cb-send" class="cb-send-btn" aria-label="Send message">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2L2 8l4 2 2 4 6-12z"/>
        </svg>
      </button>
    </div>

    <p class="cb-footer">Powered by store support bot</p>

  </div>
</div>

{% stylesheet %}
/* ══════════════════════════════════════════════════
   CHATBOT WIDGET
   ══════════════════════════════════════════════════ */

/* ── Utility ── */
.cb-hidden { display: none !important; }
.cb-sr-only {
  position: absolute; width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}

/* ── FAB ── */
.cb-fab {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 9998;
  width: 3.25rem;
  height: 3.25rem;
  border-radius: 999px;
  background: var(--color-foreground, #111);
  color: var(--color-background, #fff);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 20px rgba(0,0,0,0.22), 0 1px 4px rgba(0,0,0,0.12);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.cb-fab:hover {
  transform: scale(1.08);
  box-shadow: 0 6px 28px rgba(0,0,0,0.28);
}
.cb-fab__icon { display: flex; align-items: center; justify-content: center; }
.cb-fab__icon--close { display: none; }
.cb-fab[aria-expanded="true"] .cb-fab__icon--chat  { display: none; }
.cb-fab[aria-expanded="true"] .cb-fab__icon--close { display: flex; }

/* ── Badge ── */
.cb-badge {
  position: absolute;
  top: -2px; right: -2px;
  width: 1.125rem; height: 1.125rem;
  background: #e53e3e;
  color: #fff;
  font-size: 0.625rem;
  font-weight: 700;
  border-radius: 999px;
  display: flex; align-items: center; justify-content: center;
  border: 2px solid var(--color-background, #fff);
  animation: cb-pop 0.35s cubic-bezier(0.34,1.56,0.64,1) both;
}
@keyframes cb-pop {
  from { transform: scale(0); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}

/* ── Panel ── */
.cb-panel {
  position: fixed;
  bottom: 5.5rem;
  right: 1.5rem;
  z-index: 9997;
  width: min(380px, calc(100vw - 2rem));
  height: min(560px, calc(100svh - 8rem));
  background: var(--color-background, #fff);
  border-radius: 1.125rem;
  box-shadow:
    0 0 0 1px rgba(0,0,0,0.07),
    0 20px 60px -10px rgba(0,0,0,0.22),
    0 8px 20px -6px rgba(0,0,0,0.10);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform-origin: bottom right;
}
.cb-panel--closed {
  pointer-events: none;
  opacity: 0;
  transform: scale(0.92) translateY(0.75rem);
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.cb-panel--open {
  pointer-events: auto;
  opacity: 1;
  transform: scale(1) translateY(0);
  transition: opacity 0.25s cubic-bezier(0.34,1.3,0.64,1), transform 0.25s cubic-bezier(0.34,1.3,0.64,1);
}

/* ── Header ── */
.cb-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.875rem 1rem;
  background: var(--color-foreground, #111);
  color: var(--color-background, #fff);
  flex-shrink: 0;
}
.cb-header__info { display: flex; align-items: center; gap: 0.75rem; }
.cb-avatar {
  width: 2.25rem; height: 2.25rem;
  border-radius: 999px;
  background: rgba(255,255,255,0.15);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.cb-header__title {
  margin: 0;
  font-size: 0.875rem;
  font-weight: 600;
  line-height: 1.2;
  color: inherit;
}
.cb-header__subtitle {
  margin: 0;
  font-size: 0.6875rem;
  opacity: 0.6;
  color: inherit;
}
.cb-header__actions { display: flex; align-items: center; gap: 0.5rem; }

/* ── Lang select ── */
.cb-lang-wrap { position: relative; }
.cb-lang-select {
  appearance: none;
  background: rgba(255,255,255,0.12);
  color: inherit;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 0.375rem;
  padding: 0.25rem 0.5rem;
  font-size: 0.6875rem;
  font-weight: 600;
  cursor: pointer;
  outline: none;
}
.cb-lang-select:focus { border-color: rgba(255,255,255,0.5); }
.cb-lang-select option { background: #1a1a1a; color: #fff; }

/* ── Icon button ── */
.cb-icon-btn {
  display: flex; align-items: center; justify-content: center;
  width: 1.75rem; height: 1.75rem;
  border: none; background: rgba(255,255,255,0.1);
  border-radius: 0.375rem; cursor: pointer;
  color: rgba(255,255,255,0.8);
  transition: background 0.15s;
}
.cb-icon-btn:hover { background: rgba(255,255,255,0.2); }

/* ── Messages ── */
.cb-messages {
  flex: 1;
  overflow-y: auto;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  scroll-behavior: smooth;
  scrollbar-width: thin;
  scrollbar-color: rgba(0,0,0,0.12) transparent;
}

.cb-msg {
  display: flex;
  flex-direction: column;
  max-width: 82%;
  gap: 0.2rem;
}
.cb-msg--bot  { align-self: flex-start; align-items: flex-start; }
.cb-msg--user { align-self: flex-end;   align-items: flex-end; }

.cb-bubble {
  padding: 0.625rem 0.875rem;
  border-radius: 1rem;
  font-size: 0.875rem;
  line-height: 1.5;
  word-break: break-word;
}
.cb-bubble a { text-decoration: underline; }

.cb-msg--bot  .cb-bubble {
  background: var(--color-foreground, #111);
  color: var(--color-background, #fff);
  border-bottom-left-radius: 0.25rem;
}
.cb-msg--user .cb-bubble {
  background: rgba(0,0,0,0.06);
  color: var(--color-foreground, #111);
  border-bottom-right-radius: 0.25rem;
}

/* incoming animation */
.cb-msg { animation: cb-slide-in 0.2s ease both; }
@keyframes cb-slide-in {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.cb-time {
  font-size: 0.625rem;
  opacity: 0.35;
  padding-inline: 0.25rem;
  color: var(--color-foreground, #111);
}

/* ── Typing indicator ── */
.cb-typing {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.625rem 0.875rem;
  min-width: 3.5rem;
}
.cb-typing span {
  width: 6px; height: 6px;
  border-radius: 999px;
  background: rgba(255,255,255,0.6);
  animation: cb-bounce 1.2s ease infinite;
}
.cb-typing span:nth-child(2) { animation-delay: 0.2s; }
.cb-typing span:nth-child(3) { animation-delay: 0.4s; }
@keyframes cb-bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.6; }
  30%           { transform: translateY(-5px); opacity: 1; }
}

/* ── Quick replies ── */
.cb-quick-replies {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
  padding: 0 1rem 0.625rem;
  flex-shrink: 0;
}
.cb-qr {
  padding: 0.3125rem 0.75rem;
  border-radius: 999px;
  border: 1px solid var(--color-foreground, #111);
  background: transparent;
  color: var(--color-foreground, #111);
  font-size: 0.75rem;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  white-space: nowrap;
}
.cb-qr:hover {
  background: var(--color-foreground, #111);
  color: var(--color-background, #fff);
}

/* ── Input row ── */
.cb-input-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  border-top: 1px solid rgba(0,0,0,0.08);
  flex-shrink: 0;
}
.cb-input {
  flex: 1;
  border: 1px solid rgba(0,0,0,0.14);
  border-radius: 999px;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  outline: none;
  background: var(--color-background, #fff);
  color: var(--color-foreground, #111);
  transition: border-color 0.15s;
}
.cb-input:focus { border-color: var(--color-foreground, #111); }
.cb-input::placeholder { opacity: 0.4; }

.cb-send-btn {
  width: 2.25rem; height: 2.25rem;
  border-radius: 999px;
  background: var(--color-foreground, #111);
  color: var(--color-background, #fff);
  border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: opacity 0.15s, transform 0.15s;
}
.cb-send-btn:hover { opacity: 0.8; transform: scale(1.05); }

/* ── Footer ── */
.cb-footer {
  margin: 0;
  padding: 0.375rem 1rem 0.625rem;
  text-align: center;
  font-size: 0.625rem;
  opacity: 0.3;
  flex-shrink: 0;
  color: var(--color-foreground, #111);
}

/* ── Mobile adjustments ── */
@media (max-width: 480px) {
  .cb-fab  { bottom: 1rem; right: 1rem; }
  .cb-panel {
    right: 0; bottom: 0;
    width: 100vw;
    height: 75svh;
    border-radius: 1.25rem 1.25rem 0 0;
    transform-origin: bottom center;
  }
}
{% endstylesheet %}

<script src="{{ 'chat-bot.js' | asset_url }}" defer></script>

{%- comment -%} Init with locale detected server-side {%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sel = document.getElementById('cb-lang');
    if (sel && sel.value !== '{{ locale }}') {
      sel.value = '{{ locale }}';
    }
  });
</script>
