{%- comment -%}
  Renders the 2-step progress indicator for Cart Checkout Form
  Adheres to RULES-SHOPIFY.md (exp- prefix, DRY, no hardcoding)
{%- endcomment -%}

<div class="exp-stepper" aria-label="Progress formulir checkout">
  <div class="exp-stepper__track">
    <div class="exp-stepper__item is-active" data-step-index="1">
      <div class="exp-stepper__badge">
        <span class="exp-stepper__number">1</span>
        <svg class="exp-stepper__check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <span class="exp-stepper__label">Information</span>
    </div>

    <div class="exp-stepper__divider" aria-hidden="true">
      <div class="exp-stepper__divider-progress"></div>
    </div>

    <div class="exp-stepper__item" data-step-index="2">
      <div class="exp-stepper__badge">
        <span class="exp-stepper__number">2</span>
        <svg class="exp-stepper__check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <span class="exp-stepper__label">Detail Address</span>
    </div>
  </div>
</div>
