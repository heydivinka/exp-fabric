{%- # theme-check-disable OrphanedSnippet -%}
{% comment %}
  Strictly Dynamic Size Chart:
  1. Product Metafield: product.metafields.custom.size_chart.value
  2. Active Collection Metafield: collection.metafields.custom.default_size_chart.value
  3. Parent Collection Metafield: loop product.collections mencari custom.default_size_chart.value

  Conditional:
  - Hanya akan tampil jika entry Metafield Size Chart benar-benar diisi di produk atau koleksinya.
  - Jika tidak ada entry metafield, elemen tidak akan dirender sama sekali.
  - Tidak ada lagi preview mode statis/dummy.
{% endcomment %}

{%- liquid
  if chart == blank
    if product.metafields.custom.size_chart.value != blank
      assign chart = product.metafields.custom.size_chart.value
    elsif collection.metafields.custom.default_size_chart.value != blank
      assign chart = collection.metafields.custom.default_size_chart.value
    elsif product != blank
      for col in product.collections
        if col.metafields.custom.default_size_chart.value != blank
          assign chart = col.metafields.custom.default_size_chart.value
          break
        endif
      endfor
    endif
  endif
-%}

{%- if chart != blank and chart.rows.value.size > 0 -%}
  {%- liquid
    assign has_chest = false
    assign has_waist = false
    assign has_hip = false
    assign has_length = false
    assign has_shoulder = false
    assign has_sleeve = false

    for row in chart.rows.value
      assign c_val = row.chest_cm.value | default: row.chest_cm
      assign w_val = row.waist_cm.value | default: row.waist_cm
      assign h_val = row.hip_cm.value | default: row.hip_cm
      assign l_val = row.length_cm.value | default: row.length_cm
      assign sh_val = row.shoulder_cm.value | default: row.shoulder_cm
      assign sl_val = row.sleeve_cm.value | default: row.sleeve_cm

      if c_val != blank and c_val != 0
        assign has_chest = true
      endif
      if w_val != blank and w_val != 0
        assign has_waist = true
      endif
      if h_val != blank and h_val != 0
        assign has_hip = true
      endif
      if l_val != blank and l_val != 0
        assign has_length = true
      endif
      if sh_val != blank and sh_val != 0
        assign has_shoulder = true
      endif
      if sl_val != blank and sl_val != 0
        assign has_sleeve = true
      endif
    endfor
  -%}

  {% comment %} Tombol Pemicu Text-Link Minimalis (Gaya Mandalas) {% endcomment %}
  <div class="product__size-chart-wrapper">
    <button
      type="button"
      class="size-chart-trigger"
      id="SizeChartTrigger"
      style="{% if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' %}color: {{ block.settings.text_color }} !important;{% endif %}"
    >
      {% if block.settings.show_ruler_icon != false %}
        <svg class="size-chart-trigger__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.3 4.3a2.1 2.1 0 0 0-3-3L1.7 17.9a2.1 2.1 0 0 0 0 3l1.4 1.4a2.1 2.1 0 0 0 3 0L22.7 5.7c.3-.3.3-.9 0-1.2l-1.4-1.4zM7.5 13.5l1.5-1.5M10.5 16.5l1.5-1.5M13.5 10.5l1.5-1.5M16.5 13.5l1.5-1.5M4.5 16.5l1.5-1.5M19.5 7.5l-1.5 1.5"/>
        </svg>
      {% endif %}
      <span class="size-chart-trigger__text">
        {%- if block.settings.button_label != blank -%}
          {{ block.settings.button_label }}
        {%- else -%}
          {{ 'products.size_chart.button_label' | t }}
        {%- endif -%}
      </span>
    </button>
  </div>

  {%- liquid
    assign modal_title = chart.title.value | default: chart.title
    if block.settings.heading_source == 'product' or block.settings.heading_source == blank
      assign modal_title = product.title | default: modal_title
    elsif block.settings.heading_source == 'custom' and block.settings.custom_heading != blank
      assign modal_title = block.settings.custom_heading
    elsif block.settings.heading_source == 'chart'
      assign modal_title = chart.title.value | default: chart.title
    endif
  -%}

  {% comment %} Slide-out Drawer Dialog (<dialog>) {% endcomment %}
  <dialog
    id="SizeChartDialog"
    class="size-chart-drawer"
    aria-labelledby="SizeChartTitle"
    data-default-unit="{{ block.settings.default_unit | default: 'cm' }}"
  >
    <div class="size-chart-drawer__inner">
      <div class="size-chart-drawer__header">
        <h2
          id="SizeChartTitle"
          class="size-chart-drawer__title"
          style="font-family: var(--font-body--family, inherit) !important; font-weight: var(--font-body--weight, 400) !important; font-size: clamp(1.5rem, 4vw, 2rem) !important; line-height: var(--line-height--body-normal, normal) !important; letter-spacing: var(--letter-spacing--body-normal, normal) !important; text-transform: none !important; text-wrap: pretty !important;"
        >
          {{ modal_title }}
        </h2>
        <button type="button" class="size-chart-drawer__close" id="SizeChartClose" aria-label="{{ 'products.size_chart.close' | t }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      {%- assign chart_desc = chart.description.value | default: chart.description -%}
      {%- if chart_desc != blank -%}
        <p class="size-chart-drawer__desc">{{ chart_desc }}</p>
      {%- endif -%}

      {% comment %} Toggle Satuan CM / Inci {% endcomment %}
      <div class="size-chart-unit-switcher">
        <button type="button" class="unit-toggle-btn active" data-unit="cm">{{ 'products.size_chart.unit_cm' | t }}</button>
        <button type="button" class="unit-toggle-btn" data-unit="inch">{{ 'products.size_chart.unit_inch' | t }}</button>
      </div>

      {% comment %} Bonus: Rekomendasi Ukuran (Size Recommender) {% endcomment %}
      {%- liquid
        assign metric_count = 0
        if has_chest
          assign metric_count = metric_count | plus: 1
        endif
        if has_waist
          assign metric_count = metric_count | plus: 1
        endif
        if has_hip
          assign metric_count = metric_count | plus: 1
        endif

        assign default_metric = 'chest'
        assign default_metric_label = 'products.size_chart.chest' | t
        if has_chest == false and has_waist
          assign default_metric = 'waist'
          assign default_metric_label = 'products.size_chart.waist' | t
        elsif has_chest == false and has_waist == false and has_hip
          assign default_metric = 'hip'
          assign default_metric_label = 'products.size_chart.hip' | t
        endif
      -%}

      {% if metric_count > 0 %}
        <div class="size-chart-recommender" data-metric="{{ default_metric }}">
          <div class="size-chart-recommender__header">
            <span class="size-chart-recommender__title">{{ 'products.size_chart.find_size_title' | t }}</span>
            <div class="size-chart-recommender__desc-row">
              {% if metric_count > 1 %}
                <label for="SizeRecommenderMetricSelect" class="size-chart-recommender__desc">
                  {{ 'products.size_chart.find_size_choose_metric' | t }}:
                </label>
                <select id="SizeRecommenderMetricSelect" class="size-chart-recommender__select">
                  {% if has_chest %}<option value="chest" selected>{{ 'products.size_chart.chest' | t }}</option>{% endif %}
                  {% if has_waist %}<option value="waist"{% unless has_chest %} selected{% endunless %}>{{ 'products.size_chart.waist' | t }}</option>{% endif %}
                  {% if has_hip %}<option value="hip">{{ 'products.size_chart.hip' | t }}</option>{% endif %}
                </select>
              {% else %}
                <span class="size-chart-recommender__desc">
                  {{ 'products.size_chart.find_size_desc' | t: metric: default_metric_label }}
                </span>
              {% endif %}
            </div>
          </div>
          <div class="size-chart-recommender__form">
            <div class="size-chart-recommender__input-wrapper">
              <input
                type="number"
                step="0.1"
                min="10"
                max="300"
                class="size-chart-recommender__input"
                id="SizeRecommenderInput"
                placeholder="{{ 'products.size_chart.find_size_placeholder' | t }}"
                aria-label="{{ default_metric_label }}"
              >
              <span class="size-chart-recommender__unit unit-text">cm</span>
            </div>
            <button type="button" class="size-chart-recommender__btn" id="SizeRecommenderBtn">
              {{ 'products.size_chart.find_size_button' | t }}
            </button>
            <button type="button" class="size-chart-recommender__reset hidden" id="SizeRecommenderReset">
              {{ 'products.size_chart.find_size_reset' | t }}
            </button>
          </div>
          <div
            class="size-chart-recommender__result hidden"
            id="SizeRecommenderResult"
            data-template="{{ 'products.size_chart.find_size_result' | t: size: '[SIZE]' }}"
          ></div>
        </div>
      {% endif %}

      {% comment %} Tabel Ukuran Dinamis {% endcomment %}
      <div class="size-chart-table-container">
        <table class="size-chart-table">
          <thead>
            <tr>
              <th class="sticky-column">{{ 'products.size_chart.size' | t }}</th>
              {% if has_chest %}
                <th>{{ 'products.size_chart.chest' | t }}</th>
              {% endif %}
              {% if has_waist %}
                <th>{{ 'products.size_chart.waist' | t }}</th>
              {% endif %}
              {% if has_hip %}
                <th>{{ 'products.size_chart.hip' | t }}</th>
              {% endif %}
              {% if has_length %}
                <th>{{ 'products.size_chart.length' | t }}</th>
              {% endif %}
              {% if has_shoulder %}
                <th>{{ 'products.size_chart.shoulder' | t }}</th>
              {% endif %}
              {% if has_sleeve %}
                <th>{{ 'products.size_chart.sleeve' | t }}</th>
              {% endif %}
            </tr>
          </thead>
          <tbody>
            {% for row in chart.rows.value %}
              {% assign c_val = row.chest_cm.value | default: row.chest_cm %}
              {% assign w_val = row.waist_cm.value | default: row.waist_cm %}
              {% assign h_val = row.hip_cm.value | default: row.hip_cm %}
              {% assign l_val = row.length_cm.value | default: row.length_cm %}
              {% assign sh_val = row.shoulder_cm.value | default: row.shoulder_cm %}
              {% assign sl_val = row.sleeve_cm.value | default: row.sleeve_cm %}

              <tr
                data-size="{{ row.size.value | default: row.size }}"
                {% if c_val != blank and c_val != 0 %}data-chest="{{ c_val }}"{% endif %}
                {% if w_val != blank and w_val != 0 %}data-waist="{{ w_val }}"{% endif %}
                {% if h_val != blank and h_val != 0 %}data-hip="{{ h_val }}"{% endif %}
              >
                <th class="sticky-column">{{ row.size.value | default: row.size }}</th>

                {% if has_chest %}
                  <td>
                    {% if c_val != blank and c_val != 0 %}
                      <span class="size-val" data-cm="{{ c_val }}">{{ c_val }}</span> <span class="unit-text">cm</span>
                    {% else %}
                      -
                    {% endif %}
                  </td>
                {% endif %}

                {% if has_waist %}
                  <td>
                    {% if w_val != blank and w_val != 0 %}
                      <span class="size-val" data-cm="{{ w_val }}">{{ w_val }}</span> <span class="unit-text">cm</span>
                    {% else %}
                      -
                    {% endif %}
                  </td>
                {% endif %}

                {% if has_hip %}
                  <td>
                    {% if h_val != blank and h_val != 0 %}
                      <span class="size-val" data-cm="{{ h_val }}">{{ h_val }}</span> <span class="unit-text">cm</span>
                    {% else %}
                      -
                    {% endif %}
                  </td>
                {% endif %}

                {% if has_length %}
                  <td>
                    {% if l_val != blank and l_val != 0 %}
                      <span class="size-val" data-cm="{{ l_val }}">{{ l_val }}</span> <span class="unit-text">cm</span>
                    {% else %}
                      -
                    {% endif %}
                  </td>
                {% endif %}

                {% if has_shoulder %}
                  <td>
                    {% if sh_val != blank and sh_val != 0 %}
                      <span class="size-val" data-cm="{{ sh_val }}">{{ sh_val }}</span> <span class="unit-text">cm</span>
                    {% else %}
                      -
                    {% endif %}
                  </td>
                {% endif %}

                {% if has_sleeve %}
                  <td>
                    {% if sl_val != blank and sl_val != 0 %}
                      <span class="size-val" data-cm="{{ sl_val }}">{{ sl_val }}</span> <span class="unit-text">cm</span>
                    {% else %}
                      -
                    {% endif %}
                  </td>
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if block.settings.show_guide_image %}
        {% assign g_img = chart.guide_image.value | default: chart.guide_image %}
        {% if g_img != blank %}
          <div class="size-chart-guide-image">
            {{ g_img | image_url: width: 700 | image_tag: loading: 'lazy' }}
          </div>
        {% endif %}
      {% endif %}

      {% assign chart_notes = chart.notes.value | default: chart.notes %}
      {% if chart_notes != blank %}
        <div class="size-chart-notes rte">
          {% if chart.notes.value %}
            {{ chart.notes | metafield_tag }}
          {% else %}
            {{ chart_notes }}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </dialog>

  {%- # theme-check-disable MissingAsset -%}
  <script src="{{ 'size-chart.js' | asset_url }}" defer></script>
  {{ 'size-chart.css' | asset_url | stylesheet_tag }}
  {%- # theme-check-enable MissingAsset -%}
{%- endif -%}
