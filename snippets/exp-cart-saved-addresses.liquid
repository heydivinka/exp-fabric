{%- comment -%}
  Exp Cart Saved Addresses Selector Snippet
  Compliance: RULES-SHOPIFY.md (exp- prefix, DRY, no hardcoding, comprehensive schema support)
  Renders list of customer saved addresses in interactive cards or compact dropdown with live CRUD
{%- endcomment -%}

{%- if customer -%}
  <div class="exp-saved-addresses-wrapper" data-layout="{{ saved_addresses_style | default: 'cards' }}">
    {%- if saved_addresses_heading != blank -%}
      <div class="exp-saved-addresses-header">
        <{{ heading_tag | default: 'h3' }} class="exp-saved-addresses-title">
          {{ saved_addresses_heading }}
        </{{ heading_tag | default: 'h3' }}>
        <span class="exp-saved-addresses-count" id="exp-saved-addresses-count">({{ customer.addresses.size }} alamat tersimpan)</span>
      </div>
    {%- endif -%}

    {%- if saved_addresses_style == 'dropdown' -%}
      {%- comment -%} Mode Dropdown Ringkas {%- endcomment -%}
      <div class="exp-saved-addresses-dropdown-container">
        <div class="exp-select-wrapper">
          <select id="exp-saved-address-select" class="exp-input exp-saved-address-select" aria-label="{{ saved_addresses_heading | default: 'Pilih Alamat Tersimpan' }}">
            {%- for addr in customer.addresses -%}
              {%- assign is_def = false -%}
              {%- if addr == customer.default_address -%}{%- assign is_def = true -%}{%- endif -%}
              <option value="{{ addr.id }}" {% if is_def %}selected{% endif %}>
                {% if is_def %}[Utama] {% endif %}{{ addr.name | default: customer.name }} - {{ addr.address1 }}, {{ addr.city }} ({{ addr.zip }})
              </option>
            {%- endfor -%}
            {%- if allow_new_address -%}
              <option value="new">+ Gunakan Alamat Pengiriman Baru...</option>
            {%- endif -%}
          </select>
          <span class="exp-select-arrow" aria-hidden="true">
            <svg width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </div>

    {%- else -%}
      {%- comment -%} Mode Grid Kartu Interaktif (Default) {%- endcomment -%}
      <div class="exp-saved-addresses-grid" role="radiogroup" aria-label="{{ saved_addresses_heading | default: 'Pilih Alamat Tersimpan' }}">
        {%- for addr in customer.addresses -%}
          {%- assign is_def = false -%}
          {%- if addr == customer.default_address -%}{%- assign is_def = true -%}{%- endif -%}
          <div
            class="exp-address-card {% if is_def %}is-active is-default{% endif %}"
            data-address-id="{{ addr.id }}"
            role="radio"
            aria-checked="{% if is_def %}true{% else %}false{% endif %}"
            tabindex="0"
          >
            <div class="exp-address-card-top">
              <div class="exp-address-card-badges">
                {%- if is_def -%}
                  <span class="exp-badge-primary">Alamat Utama</span>
                {%- endif -%}
                {%- if addr.company != blank -%}
                  <span class="exp-badge-secondary">{{ addr.company }}</span>
                {%- endif -%}
              </div>
              <div class="exp-address-card-radio-indicator" aria-hidden="true">
                <span class="exp-radio-circle"></span>
              </div>
            </div>

            <div class="exp-address-card-body">
              <div class="exp-address-card-name">
                {{ addr.first_name }} {{ addr.last_name }}
              </div>
              {%- if addr.phone != blank or customer.phone != blank -%}
                <div class="exp-address-card-phone">
                  {{ addr.phone | default: customer.phone }}
                </div>
              {%- endif -%}
              <div class="exp-address-card-text">
                {{ addr.address1 }}
                {%- if addr.address2 != blank -%}, {{ addr.address2 }}{%- endif -%}<br>
                {{ addr.city }}, {{ addr.province }} {{ addr.zip }}
              </div>
            </div>

            <div class="exp-address-card-crud-actions">
              <button
                type="button"
                class="exp-card-action-btn exp-card-action-btn--edit"
                data-action="edit-address"
                data-address-id="{{ addr.id }}"
                title="Edit alamat ini"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                <span>Edit</span>
              </button>

              <button
                type="button"
                class="exp-card-action-btn exp-card-action-btn--delete"
                data-action="delete-address"
                data-address-id="{{ addr.id }}"
                title="Hapus alamat ini dari akun"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                <span>Hapus</span>
              </button>
            </div>

            {%- if enable_one_click -%}
              <div class="exp-address-card-actions">
                <button
                  type="button"
                  class="exp-address-fast-checkout-btn"
                  data-action="fast-checkout"
                  data-address-id="{{ addr.id }}"
                  title="Langsung menuju pembayaran dengan alamat ini"
                >
                  ⚡ Langsung Checkout
                </button>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if allow_new_address -%}
          <div
            class="exp-address-card exp-address-card--new {% if customer.addresses.size == 0 %}is-active{% endif %}"
            data-address-id="new"
            role="radio"
            aria-checked="{% if customer.addresses.size == 0 %}true{% else %}false{% endif %}"
            tabindex="0"
            title="Isi alamat baru di formulir"
          >
            <div class="exp-address-card--new-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </div>
            <div class="exp-address-card--new-title">Gunakan Alamat Baru</div>
            <div class="exp-address-card--new-subtitle">Isi alamat pengiriman yang berbeda</div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
