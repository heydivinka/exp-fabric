{%- liquid
  assign heading    = section.settings.heading
  assign subheading = section.settings.subheading
-%}

<div class="tw-fh-section">

  {%- comment -%} ── Section header ─────────────────────── {%- endcomment -%}
  <div class="tw-fh-inner">
    <div class="tw-fh-header">
      {%- if subheading != blank -%}
        <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3">
          {{- subheading -}}
        </p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="text-3xl md:text-5xl font-bold bg-gradient-to-r from-black to-neutral-500 bg-clip-text text-transparent">
          {{- heading -}}
        </h2>
      {%- endif -%}
    </div>

    {%- comment -%} ── Cards grid ─────────────────────────── {%- endcomment -%}
    <div class="tw-fh-grid">

      {%- for block in section.blocks -%}
        {%- liquid
          assign emoji      = block.settings.emoji
          assign card_title = block.settings.title
          assign card_body  = block.settings.body
          assign tag        = block.settings.tag
        -%}

        <div
          class="group relative flex flex-col gap-4 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm transition duration-300 hover:shadow-md hover:-translate-y-1 overflow-hidden"
          {{ block.shopify_attributes }}
        >
          <div class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-neutral-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          <div class="relative flex items-start justify-between">
            {%- if emoji != blank -%}
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-neutral-100 text-2xl">
                {{- emoji -}}
              </span>
            {%- endif -%}
            {%- if tag != blank -%}
              <span class="rounded-full bg-neutral-900 px-2.5 py-0.5 text-xs font-semibold text-white">
                {{- tag -}}
              </span>
            {%- endif -%}
          </div>

          <div class="relative flex flex-col gap-1.5">
            {%- if card_title != blank -%}
              <p class="text-base font-semibold text-neutral-900">{{- card_title -}}</p>
            {%- endif -%}
            {%- if card_body != blank -%}
              <p class="text-sm leading-relaxed text-neutral-500">{{- card_body -}}</p>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}

    </div>
  </div>
</div>

{% stylesheet %}
  /* Break keluar dari grid constraint theme dan buat full width beneran */
  .tw-fh-section {
    position: relative;
    width: 100vw;
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    padding-block: 5rem;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
  }

  /* Inner wrapper: center content dan batasi max width */
  .tw-fh-inner {
    max-width: 1280px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* Header: center text */
  .tw-fh-header {
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }

  /* Grid cards: responsive */
  .tw-fh-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .tw-fh-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .tw-fh-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

  {% schema %}
  {
    "name": "TW Feature Highlights",
    "tag": "div",
    "blocks": [
      {
        "type": "feature",
        "name": "Feature card",
        "settings": [
          {
            "type": "text",
            "id": "emoji",
            "label": "Emoji / icon",
            "default": "✦"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Feature title"
          },
          {
            "type": "textarea",
            "id": "body",
            "label": "Description",
            "default": "Short description that explains what this feature does and why it matters."
          },
          {
            "type": "text",
            "id": "tag",
            "label": "Badge label",
            "info": "Optional pill badge, e.g. \"New\" or \"Popular\". Leave blank to hide."
          }
        ]
      }
    ],
    "settings": [
      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Why choose us"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Everything you need, nothing you don't"
      }
    ],
    "presets": [
      {
        "name": "TW Feature Highlights",
        "category": "Tailwind",
        "blocks": [
          {
            "type": "feature",
            "settings": {
              "emoji": "🧵",
              "title": "Premium materials",
              "body": "Every piece is crafted from sustainably sourced fabrics built to last through years of wear.",
              "tag": "Popular"
            }
          },
          {
            "type": "feature",
            "settings": {
              "emoji": "📦",
              "title": "Fast shipping",
              "body": "Orders placed before 2pm ship the same day, with tracking updates every step of the way."
            }
          },
          {
            "type": "feature",
            "settings": {
              "emoji": "♻️",
              "title": "Sustainable by design",
              "body": "From packaging to production, we minimise waste at every stage of the supply chain.",
              "tag": "New"
            }
          }
        ]
      }
    ]
  }
  {% endschema %}
