{%- comment -%}
  Exp Cart Form Auto Filled Checkout
  Author: Expert Shopify Developer
  Compliance: RULES-SHOPIFY.md (exp- prefix, DRY, no hardcoding, comprehensive schema)
  Assets: assets/exp-cart-checkout-form.css, assets/exp-cart-checkout-form.js
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign customer_first_name = customer.first_name | default: ''
  assign customer_last_name = customer.last_name | default: ''
  assign customer_email = customer.email | default: ''
  assign customer_phone = customer.phone | default: customer.default_address.phone | default: ''
  assign customer_address1 = customer.default_address.address1 | default: ''
  assign customer_city = customer.default_address.city | default: ''
  assign customer_province = customer.default_address.province | default: ''
  assign customer_zip = customer.default_address.zip | default: ''
-%}

<style>
  #shopify-section-{{ section.id }} {
    --exp-primary: {{ s.color_primary }};
    --exp-foreground: {{ s.color_foreground }};
    --exp-border: {{ s.color_border }};
    --exp-input-bg: {{ s.color_input_bg }};
    --exp-input-fg: {{ s.color_input_fg }};
    --exp-background: {{ s.color_background }};
    --exp-input-rounded: {{ s.input_rounded }}px;
    --exp-button-rounded: {{ s.button_rounded }}px;
    --exp-container-desktop: {{ s.container_width_desktop }}px;
    --exp-container-mobile: {{ s.container_width_mobile }}%;
    --exp-pad-top-dt: {{ s.padding_top_desktop }}px;
    --exp-pad-bot-dt: {{ s.padding_bottom_desktop }}px;
    --exp-pad-top-mb: {{ s.padding_top_mobile }}px;
    --exp-pad-bot-mb: {{ s.padding_bottom_mobile }}px;
    --exp-heading-dt: {{ s.heading_size_desktop }}px;
    --exp-heading-mb: {{ s.heading_size_mobile }}px;
    --exp-text-align: {{ s.text_alignment }};

    /* Button Colors */
    --exp-btn-primary-bg: {{ s.color_btn_primary_bg | default: s.color_primary }};
    --exp-btn-primary-fg: {{ s.color_btn_primary_text | default: s.color_foreground }};
    --exp-btn-secondary-bg: {{ s.color_btn_secondary_bg | default: '#FFFFFF' }};
    --exp-btn-secondary-fg: {{ s.color_btn_secondary_text | default: s.color_input_fg }};
    --exp-btn-secondary-border: {{ s.color_btn_secondary_border | default: s.color_border }};
    --exp-btn-save-bg: {{ s.color_btn_save_bg | default: s.color_foreground }};
    --exp-btn-save-fg: {{ s.color_btn_save_text | default: '#FFFFFF' }};
    --exp-btn-delete-hover: {{ s.color_btn_delete_hover | default: '#DC2626' }};

    /* Badges */
    --exp-badge-saved-bg: {{ s.color_badge_saved_bg | default: '#F0FDF4' }};
    --exp-badge-saved-fg: {{ s.color_badge_saved_text | default: '#166534' }};
    --exp-badge-new-bg: {{ s.color_badge_new_bg | default: '#FEF9C3' }};
    --exp-badge-new-fg: {{ s.color_badge_new_text | default: '#854D0E' }};

    /* Delivery Card Colors (Active & Inactive) */
    --exp-deliv-active-border: {{ s.delivery_card_active_border | default: s.color_primary }};
    --exp-deliv-active-bg: {{ s.delivery_card_active_bg | default: '#FFFDF0' }};
    --exp-deliv-active-text: {{ s.delivery_card_active_text | default: s.color_foreground }};
    --exp-deliv-inactive-border: {{ s.delivery_card_inactive_border | default: '#E5E7EB' }};
    --exp-deliv-inactive-bg: {{ s.delivery_card_inactive_bg | default: '#FFFFFF' }};
    --exp-deliv-inactive-text: {{ s.delivery_card_inactive_text | default: '#4B5563' }};
  }
</style>

{%- # theme-check-disable MissingAsset -%}
{{ 'exp-cart-checkout-form.css' | asset_url | stylesheet_tag }}
{%- # theme-check-enable MissingAsset -%}

<div
  class="exp-cart-form-wrapper"
  data-checkout-action="{{ s.checkout_button_action }}"
  data-storefront-token="{{ s.storefront_access_token | escape }}"
  data-storefront-version="{{ s.storefront_version | strip | default: '2026-10' }}"
  data-region-api="{{ s.region_api | strip | default: 'https://www.emsifa.com/api-wilayah-indonesia/v2' }}"
  data-phone-prefix="{{ s.phone_prefix | default: '+62' }}"
  data-require-village="{{ s.require_village }}"
  data-village-placement="{{ s.village_placement }}"
  data-customer-first-name="{{ customer_first_name | escape }}"
  data-customer-last-name="{{ customer_last_name | escape }}"
  data-customer-phone="{{ customer_phone | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="exp-cart-form-container">
    
    {%- comment -%} Delivery Method Options (Express vs Instant / Dynamic Blocks) {%- endcomment -%}
    {% render 'exp-cart-delivery-method',
      section: section,
      delivery_method_heading: s.delivery_method_heading,
      express_title: s.express_title,
      express_subtext: s.express_subtext,
      instant_title: s.instant_title,
      instant_subtext: s.instant_subtext
    %}

    {%- comment -%} Saved Addresses Selector (Logged-in Customers) {%- endcomment -%}
    {%- if customer and s.enable_saved_addresses_selector -%}
      {% render 'exp-cart-saved-addresses',
        saved_addresses_style: s.saved_addresses_style,
        saved_addresses_heading: s.saved_addresses_heading,
        allow_new_address: s.allow_new_address_entry,
        enable_one_click: s.enable_one_click_checkout,
        heading_tag: s.heading_tag,
        badge_primary_text: s.badge_primary_text,
        new_address_title: s.new_address_title,
        new_address_subtext: s.new_address_subtext,
        card_edit_text: s.card_edit_text,
        card_delete_text: s.card_delete_text,
        fast_checkout_text: s.fast_checkout_text
      %}

      {%- if s.enable_address_edit_modal -%}
        {% render 'exp-cart-address-modal',
          phone_prefix: s.phone_prefix,
          modal_title: s.modal_title,
          modal_cancel_btn_text: s.modal_cancel_btn_text,
          modal_save_btn_text: s.modal_save_btn_text
        %}
      {%- endif -%}

      <script type="application/json" id="exp-customer-saved-addresses-json">
        [
          {%- if customer.addresses.size > 0 -%}
            {%- for addr in customer.addresses -%}
              {
                "id": {{ addr.id | json }},
                "isDefault": {% if addr == customer.default_address %}true{% else %}false{% endif %},
                "firstName": {{ addr.first_name | json }},
                "lastName": {{ addr.last_name | json }},
                "name": {{ addr.name | json }},
                "company": {{ addr.company | json }},
                "phone": {{ addr.phone | default: customer.phone | json }},
                "address1": {{ addr.address1 | json }},
                "address2": {{ addr.address2 | json }},
                "city": {{ addr.city | json }},
                "province": {{ addr.province | json }},
                "provinceCode": {{ addr.province_code | json }},
                "zip": {{ addr.zip | json }},
                "country": {{ addr.country | json }},
                "countryCode": {{ addr.country_code | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          {%- endif -%}
        ]
      </script>
    {%- endif -%}

    {%- comment -%} Stepper (1 Information -> 2 Detail Address) {%- endcomment -%}
    {% render 'exp-cart-stepper',
      step_1_label: s.step_1_label,
      step_2_label: s.step_2_label
    %}

    <form id="exp-cart-checkout-form" class="exp-cart-form" novalidate>
      {%- comment -%} Step 1: Recipient Information {%- endcomment -%}
      {% render 'exp-cart-step-information',
        heading_tag: s.heading_tag,
        default_first_name: customer_first_name,
        default_last_name: customer_last_name,
        default_email: customer_email,
        default_phone: customer_phone,
        phone_prefix: s.phone_prefix,
        step_1_heading: s.step_1_heading,
        step_1_btn_text: s.step_1_btn_text,
        badge_new_address_text: s.badge_new_address_text,
        autofill_hint_text: s.autofill_hint_text,
        btn_fill_contact_text: s.btn_fill_contact_text
      %}

      {%- comment -%} Step 2: Detail Address {%- endcomment -%}
      {% render 'exp-cart-step-address',
        heading_tag: s.heading_tag,
        default_address1: customer_address1,
        default_city: customer_city,
        default_province: customer_province,
        default_zip: customer_zip,
        step_2_heading: s.step_2_heading,
        save_address_checkbox_text: s.save_address_checkbox_text,
        save_address_btn_text: s.save_address_btn_text,
        cancel_edit_btn_text: s.cancel_edit_btn_text,
        step_2_back_btn_text: s.step_2_back_btn_text,
        step_2_complete_btn_text: s.step_2_complete_btn_text
      %}
    </form>

  </div>
</div>

{%- # theme-check-disable MissingAsset -%}
<script type="module" src="{{ 'exp-cart-checkout-form.js' | asset_url }}"></script>
{%- # theme-check-enable MissingAsset -%}

{% schema %}
{
  "name": "Cart Form Auto Checkout",
  "tag": "section",
  "class": "exp-cart-checkout-form-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Container"
    },
    {
      "type": "range",
      "id": "container_width_desktop",
      "min": 400,
      "max": 1920,
      "step": 40,
      "unit": "px",
      "label": "Container Width (Desktop)",
      "default": 1200
    },
    {
      "type": "range",
      "id": "container_width_mobile",
      "min": 80,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Container Width (Mobile)",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Tipografi"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h3"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size (Mobile)",
      "default": 18
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Skema Warna (Sesuai Spesifikasi Desain)"
    },
    {
      "type": "color",
      "id": "color_primary",
      "label": "Primary (Brand Highlight / Button)",
      "default": "#F2CC3A",
      "info": "Warna tombol utama, active indicator, dan highlight"
    },
    {
      "type": "color",
      "id": "color_foreground",
      "label": "Foreground (Text on Primary)",
      "default": "#010101",
      "info": "Warna teks di atas elemen berwarna primer"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Border Color",
      "default": "#2E2A39",
      "info": "Warna garis tepi input dan pemisah"
    },
    {
      "type": "color",
      "id": "color_input_bg",
      "label": "Input Background",
      "default": "#FFFFFF",
      "info": "Warna latar kotak input, select, dan textarea"
    },
    {
      "type": "color",
      "id": "color_input_fg",
      "label": "Input Foreground",
      "default": "#1F2937",
      "info": "Warna teks dan placeholder isian"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Section Background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Warna Tombol (Button Colors)"
    },
    {
      "type": "color",
      "id": "color_btn_primary_bg",
      "label": "Tombol Primary (Background)",
      "default": "#F2CC3A"
    },
    {
      "type": "color",
      "id": "color_btn_primary_text",
      "label": "Tombol Primary (Teks)",
      "default": "#010101"
    },
    {
      "type": "color",
      "id": "color_btn_secondary_bg",
      "label": "Tombol Secondary (Background)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_btn_secondary_text",
      "label": "Tombol Secondary (Teks)",
      "default": "#1F2937"
    },
    {
      "type": "color",
      "id": "color_btn_secondary_border",
      "label": "Tombol Secondary (Border)",
      "default": "#2E2A39"
    },
    {
      "type": "color",
      "id": "color_btn_save_bg",
      "label": "Tombol Save Address (Background)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_btn_save_text",
      "label": "Tombol Save Address (Teks)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_btn_delete_hover",
