    {
      "type": "color",
      "id": "color_badge_saved_bg",
      "label": "Badge Alamat Tersimpan (BG)",
      "default": "#F0FDF4"
    },
    {
      "type": "color",
      "id": "color_badge_saved_text",
      "label": "Badge Alamat Tersimpan (Teks)",
      "default": "#166534"
    },
    {
      "type": "color",
      "id": "color_badge_new_bg",
