      "info": "Warna latar kartu pengiriman saat aktif/dipilih"
    },
    {
      "type": "color",
      "id": "delivery_card_active_text",
      "label": "Delivery Active (Teks)",
      "default": "#010101",
      "info": "Warna teks judul kartu saat aktif/dipilih"
    },
    {
      "type": "color",
      "id": "delivery_card_inactive_border",
      "label": "Delivery Inactive (Border)",
      "default": "#E5E7EB",
      "info": "Warna garis tepi kartu pengiriman saat tidak aktif"
