{%- liquid
  assign promo_code  = section.settings.promo_code
  assign discount    = section.settings.discount_text
  assign heading     = section.settings.heading
  assign subheading  = section.settings.subheading
  assign body        = section.settings.body
  assign btn_label   = section.settings.btn_label
  assign image       = section.settings.image
  assign cookie_days = section.settings.cookie_days
  assign show_delay  = section.settings.show_delay
-%}

<dialog id="bdp-dialog" class="bdp" aria-labelledby="bdp-heading" aria-modal="true">
  <div class="bdp__inner">

    <div class="bdp__visual">
      {%- if image != blank -%}
        {{ image | image_url: width: 600 | image_tag: class: 'bdp__img', widths: '300,500,600', sizes: '(min-width:640px) 260px, 100vw', loading: 'lazy' }}
      {%- else -%}
        <div class="bdp__img-placeholder" aria-hidden="true"><span class="bdp__cake">🎂</span></div>
      {%- endif -%}
      <div class="bdp__visual-overlay"></div>
      <p class="bdp__discount-badge">{{ discount | default: '20% OFF' }}</p>
    </div>

    <div class="bdp__content">
      <button id="bdp-close" class="bdp__close" aria-label="Close birthday offer" type="button">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13"/></svg>
      </button>

      <p class="bdp__eyebrow">🎉 Special offer just for you</p>
      <h2 id="bdp-heading" class="bdp__heading">{{ heading | default: "It's your birthday month!" }}</h2>
      <p class="bdp__body">{{ body | default: "Enter your birthday and unlock an exclusive discount — our gift to you." }}</p>

      <div id="bdp-step-form" class="bdp__step">
        <form id="bdp-form" class="bdp__form" novalidate>
          <div class="bdp__fields">
            <div class="bdp__field">
              <label for="bdp-month" class="bdp__label">Month</label>
              <select id="bdp-month" name="month" class="bdp__select" required>
                <option value="" disabled selected>Month</option>
                {%- for i in (1..12) -%}
                  <option value="{{ i }}">
                    {%- case i -%}
                      {%- when 1 -%}January{%- when 2 -%}February{%- when 3 -%}March
                      {%- when 4 -%}April{%- when 5 -%}May{%- when 6 -%}June
                      {%- when 7 -%}July{%- when 8 -%}August{%- when 9 -%}September
                      {%- when 10 -%}October{%- when 11 -%}November{%- when 12 -%}December
                    {%- endcase -%}
                  </option>
                {%- endfor -%}
              </select>
            </div>
            <div class="bdp__field">
              <label for="bdp-day" class="bdp__label">Day</label>
              <select id="bdp-day" name="day" class="bdp__select" required>
                <option value="" disabled selected>Day</option>
                {%- for i in (1..31) -%}
                  <option value="{{ i }}">{{ i }}</option>
                {%- endfor -%}
              </select>
            </div>
          </div>
          <div class="bdp__field bdp__field--full">
            <label for="bdp-email" class="bdp__label">Email address</label>
            <input id="bdp-email" type="email" name="email" class="bdp__input" placeholder="you@example.com" autocomplete="email" required>
          </div>
          <p id="bdp-error" class="bdp__error" aria-live="polite" hidden>Please fill in all fields correctly.</p>
          <button type="submit" class="bdp__submit button">{{ btn_label | default: 'Claim my discount' }}</button>
        </form>
        <p class="bdp__note">No spam, ever. Unsubscribe anytime.</p>
      </div>

      <div id="bdp-step-reveal" class="bdp__step bdp__step--hidden">
        <div class="bdp__reveal">
          <p class="bdp__reveal-label">Your exclusive code</p>
          <div class="bdp__code-row">
            <span id="bdp-code" class="bdp__code">{{ promo_code | default: 'BDAY20' }}</span>
            <button id="bdp-copy" class="bdp__copy" type="button" aria-label="Copy promo code">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span id="bdp-copy-label">Copy</span>
            </button>
          </div>
          <p class="bdp__reveal-note">{{ subheading | default: 'Valid this month · Applies at checkout' }}</p>
          <a href="/collections/all" class="button bdp__shop-btn">Shop now →</a>
        </div>
      </div>
    </div>
  </div>

  <canvas id="bdp-confetti" class="bdp__confetti" aria-hidden="true"></canvas>
</dialog>

{% stylesheet %}
.bdp {
  position: fixed; inset: 0; margin: auto; padding: 0; border: none;
  border-radius: 1.25rem;
  width: min(780px, calc(100vw - 2rem));
  max-height: calc(100svh - 2rem);
  background: transparent; overflow: hidden;
  box-shadow: 0 24px 80px -12px rgba(0,0,0,0.35), 0 0 0 1px rgba(0,0,0,0.07);
  opacity: 0; transform: scale(0.94) translateY(12px);
  transition: opacity 0.28s ease, transform 0.28s cubic-bezier(0.34,1.3,0.64,1);
}
.bdp[open] { opacity: 1; transform: scale(1) translateY(0); }
.bdp::backdrop { background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }

.bdp__inner { display: grid; grid-template-columns: 1fr; height: 100%; background: var(--color-background, #fff); }
@media (min-width: 640px) { .bdp__inner { grid-template-columns: 260px 1fr; } }

.bdp__visual { position: relative; overflow: hidden; min-height: 180px; background: #1a1a1a; }
@media (min-width: 640px) { .bdp__visual { min-height: unset; } }
.bdp__img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
.bdp__img-placeholder { width: 100%; height: 100%; min-height: 180px; background: linear-gradient(135deg, #1a0a2e, #3d1a6e, #1a0a2e); display: flex; align-items: center; justify-content: center; }
.bdp__cake { font-size: 4rem; }
.bdp__visual-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 60%); }
.bdp__discount-badge { position: absolute; bottom: 1rem; left: 1rem; right: 1rem; margin: 0; font-size: 2rem; font-weight: 900; color: #fff; letter-spacing: -0.02em; line-height: 1; text-shadow: 0 2px 12px rgba(0,0,0,0.4); z-index: 1; }

.bdp__content { position: relative; padding: 2rem 1.75rem 1.75rem; display: flex; flex-direction: column; gap: 0.5rem; overflow-y: auto; background: var(--color-background, #fff); }
.bdp__close { position: absolute; top: 1rem; right: 1rem; width: 1.875rem; height: 1.875rem; border-radius: 999px; border: 1px solid rgba(0,0,0,0.12); background: var(--color-background, #fff); cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--color-foreground, #111); transition: background 0.15s; z-index: 2; }
.bdp__close:hover { background: rgba(0,0,0,0.06); }

.bdp__eyebrow { margin: 0; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(0,0,0,0.4); }
.bdp__heading { margin: 0.5rem 0 0; font-family: var(--font-heading--family); font-size: clamp(1.375rem, 3vw, 1.75rem); font-weight: 700; line-height: 1.15; color: var(--color-foreground, #111); }
.bdp__body { margin: 0.5rem 0 0; font-size: 0.9rem; line-height: 1.6; color: rgba(0,0,0,0.55); }

.bdp__step { margin-top: 1.25rem; }
.bdp__step--hidden { display: none !important; }
.bdp__fields { display: flex; gap: 0.75rem; margin-bottom: 1rem; }
.bdp__field { flex: 1; display: flex; flex-direction: column; gap: 0.3rem; }
.bdp__field--full { flex: unset; width: 100%; margin-bottom: 1rem; }
.bdp__label { font-size: 0.75rem; font-weight: 600; color: rgba(0,0,0,0.5); }
.bdp__select, .bdp__input {
  width: 100%; padding: 0.625rem 0.75rem;
  border: 1.5px solid rgba(0,0,0,0.15); border-radius: 0.5rem;
  background: var(--color-background, #fff); color: var(--color-foreground, #111);
  font-size: 0.9rem; appearance: none; outline: none; transition: border-color 0.15s;
}
.bdp__select:focus, .bdp__input:focus { border-color: var(--color-foreground, #111); }
.bdp__input::placeholder { color: rgba(0,0,0,0.3); }
.bdp__error { margin: 0 0 0.75rem; font-size: 0.8rem; color: #c53030; }
.bdp__submit { width: 100%; text-align: center; }
.bdp__note { margin: 0.75rem 0 0; font-size: 0.7rem; text-align: center; color: rgba(0,0,0,0.35); }

.bdp__reveal { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.75rem; }
.bdp__reveal-label { margin: 0; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(0,0,0,0.4); }
.bdp__code-row { display: flex; align-items: center; width: 100%; border: 2px dashed rgba(0,0,0,0.15); border-radius: 0.75rem; overflow: hidden; }
.bdp__code { flex: 1; padding: 0.75rem 1rem; font-size: 1.375rem; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-foreground, #111); }
.bdp__copy { display: flex; align-items: center; gap: 0.4rem; padding: 0.75rem 1rem; background: var(--color-foreground, #111); color: var(--color-background, #fff); border: none; cursor: pointer; font-size: 0.8rem; font-weight: 600; transition: opacity 0.15s; white-space: nowrap; }
.bdp__copy:hover { opacity: 0.85; }
.bdp__copy--copied { background: #276749; }
.bdp__reveal-note { margin: 0; font-size: 0.8rem; color: rgba(0,0,0,0.45); }
.bdp__shop-btn { margin-top: 0.25rem; width: 100%; text-align: center; }

.bdp__confetti { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; }
{% endstylesheet %}

<script>
(function () {
  'use strict';
  var COOKIE      = 'bdp_seen';
  var COOKIE_DAYS = {{ cookie_days | default: 30 }};
  var DELAY_MS    = {{ show_delay  | default: 2 }} * 1000;

  function getCookie(n) { return document.cookie.split('; ').find(function(r){ return r.startsWith(n + '='); }); }
  function setCookie(n, days) { var d = new Date(); d.setTime(d.getTime() + days * 86400000); document.cookie = n + '=1;expires=' + d.toUTCString() + ';path=/;SameSite=Lax'; }

  function runConfetti(canvas) {
    var ctx = canvas.getContext('2d');
    canvas.width = canvas.offsetWidth; canvas.height = canvas.offsetHeight;
    var W = canvas.width, H = canvas.height;
    var colors = ['#FF6B6B','#FFD93D','#6BCB77','#4D96FF','#C77DFF','#FF9F1C'];
    var pieces = Array.from({ length: 90 }, function() {
      return { x: Math.random()*W, y: -20 - Math.random()*80, r: 4 + Math.random()*5,
        color: colors[Math.floor(Math.random()*colors.length)],
        tiltAngle: 0, tiltSpeed: 0.1 + Math.random()*0.15,
        vx: Math.random()*2-1, vy: 2 + Math.random()*2.5, tilt: 0 };
    });
    var frame, count = 0;
    function draw() {
      ctx.clearRect(0,0,W,H);
      pieces.forEach(function(p) {
        ctx.beginPath(); ctx.ellipse(p.x, p.y, p.r, p.r*0.5, p.tilt, 0, 2*Math.PI);
        ctx.fillStyle = p.color; ctx.fill();
        p.tiltAngle += p.tiltSpeed; p.x += p.vx + Math.sin(p.tiltAngle)*0.8; p.y += p.vy;
        p.tilt = Math.sin(p.tiltAngle)*14;
        if (p.y > H+20) { p.y = -20; p.x = Math.random()*W; }
      });
      count++; if (count < 200) frame = requestAnimationFrame(draw); else ctx.clearRect(0,0,W,H);
    }
    draw();
    return function() { cancelAnimationFrame(frame); ctx.clearRect(0,0,W,H); };
  }

  document.addEventListener('DOMContentLoaded', function() {
    var dialog     = document.getElementById('bdp-dialog');
    var closeBtn   = document.getElementById('bdp-close');
    var form       = document.getElementById('bdp-form');
    var stepForm   = document.getElementById('bdp-step-form');
    var stepReveal = document.getElementById('bdp-step-reveal');
    var errEl      = document.getElementById('bdp-error');
    var copyBtn    = document.getElementById('bdp-copy');
    var copyLabel  = document.getElementById('bdp-copy-label');
    var codeEl     = document.getElementById('bdp-code');
    var canvas     = document.getElementById('bdp-confetti');
    if (!dialog) return;

    if (!getCookie(COOKIE)) setTimeout(function() { dialog.showModal(); setCookie(COOKIE, COOKIE_DAYS); }, DELAY_MS);

    closeBtn.addEventListener('click', function() { dialog.close(); });
    dialog.addEventListener('click', function(e) { if (e.target === dialog) dialog.close(); });

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var month = document.getElementById('bdp-month').value;
      var day   = document.getElementById('bdp-day').value;
      var email = document.getElementById('bdp-email').value.trim();
      var emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!month || !day || !emailOk) { errEl.hidden = false; return; }
      errEl.hidden = true;
      localStorage.setItem('bdp_birth_month', month);
      localStorage.setItem('bdp_birth_day', day);
      localStorage.setItem('bdp_email', email);
      stepForm.classList.add('bdp__step--hidden');
      stepReveal.classList.remove('bdp__step--hidden');
      var stop = runConfetti(canvas);
      setTimeout(stop, 5000);
    });

    copyBtn.addEventListener('click', function() {
      navigator.clipboard.writeText(codeEl.textContent.trim()).then(function() {
        copyLabel.textContent = 'Copied!'; copyBtn.classList.add('bdp__copy--copied');
        setTimeout(function() { copyLabel.textContent = 'Copy'; copyBtn.classList.remove('bdp__copy--copied'); }, 2000);
      });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Birthday Popup",
  "tag": "div",
  "limit": 1,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Left panel image", "info": "Portrait image works best." },
    { "type": "text", "id": "discount_text", "label": "Discount label", "default": "20% OFF" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "It's your birthday month!" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Enter your birthday and unlock an exclusive discount — our gift to you." },
    { "type": "text", "id": "subheading", "label": "Code validity note", "default": "Valid this month · Applies at checkout" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Claim my discount" },
    { "type": "text", "id": "promo_code", "label": "Promo code", "default": "BDAY20" },
    { "type": "header", "content": "Behaviour" },
    { "type": "range", "id": "show_delay", "label": "Delay (seconds)", "min": 0, "max": 30, "step": 1, "default": 2 },
    { "type": "range", "id": "cookie_days", "label": "Hide for (days) after dismissed", "min": 1, "max": 90, "step": 1, "default": 30 }
  ],
  "presets": [{ "name": "Birthday Popup", "category": "Promotions" }]
}
{% endschema %}
