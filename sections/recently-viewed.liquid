{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'quantity-selector-styles' %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}
{% render 'resource-list-styles' %}
{% render 'product-recommendations-styles' %}

{%- liquid
  assign bg      = section.settings.background_color
  assign columns = section.settings.columns
  assign mob_col = section.settings.mobile_columns

  capture styles
    echo '--column-count-mobile: '              | append: mob_col  | append: ';'
    echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--resource-list-row-gap-desktop: '    | append: section.settings.rows_gap    | append: 'px;'
    echo '--resource-list-columns: repeat('     | append: columns  | append: ', 1fr);'
    echo '--resource-list-columns-mobile: repeat(' | append: mob_col | append: ', 1fr);'
    echo '--column-count: '                     | append: columns  | append: ';'
  endcapture

  comment
    Build a comma-separated list of rendered product IDs
    so JS knows exactly which IDs are available in the DOM
  endcomment
  assign rv_rendered_ids = ''
  for rv_product in collections.all.products limit: 100
    unless rv_product.id == product.id
      if rv_rendered_ids != ''
        assign rv_rendered_ids = rv_rendered_ids | append: ','
      endif
      assign rv_rendered_ids = rv_rendered_ids | append: rv_product.id
    endunless
  endfor
-%}

{%- if bg != blank -%}
  {%- render 'contrast-override', background_color: bg, section_id: section.id -%}
{%- endif -%}

<div class="section-background{% if bg != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  id="rv-section-{{ section.id }}"
  class="
    recently-viewed-section
    section
    section--{{ section.settings.section_width }}
    section-resource-list
    spacing-style
    gap-style
    {% if bg != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
    {{ styles }}
  "
  data-current-id="{{ product.id }}"
  data-rendered-ids="{{ rv_rendered_ids }}"
  {{ section.shopify_attributes }}
>

  {%- comment -%}
    Heading: hidden via aria-hidden + CSS until JS reveals it.
    Using a class instead of the HTML `hidden` attribute avoids
    Shopify theme editor stripping content in design mode.
  {%- endcomment -%}
  <div class="section-resource-list__content rv-heading rv-hidden">
    {% content_for 'blocks' %}
  </div>

  {%- comment -%}
    Cards: all pre-rendered server-side, hidden individually.
    JS shows only the ones matching localStorage viewedProducts,
    in the correct recency order, max 5.
  {%- endcomment -%}
  <div class="resource-list resource-list--grid rv-grid rv-hidden">
    {%- for rv_product in collections.all.products limit: 100 -%}
      {%- unless rv_product.id == product.id -%}
        <div class="resource-list__item rv-card rv-hidden" data-product-id="{{ rv_product.id }}">
          {%- content_for 'block',
            type: '_product-card',
            id: 'static-product-card',
            closest.product: rv_product,
            product_view_context: 'recommendation'
          -%}
        </div>
      {%- endunless -%}
    {%- endfor -%}
  </div>

</div>

<script>
(function () {
  'use strict';

  var STORAGE_KEY = 'viewedProducts';
  var MAX_SHOW    = 5;

  function getViewedIds() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return [];
      var parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch (_) {
      return [];
    }
  }

  function init() {
    var wrapper = document.getElementById('rv-section-{{ section.id }}');
    if (!wrapper) return;

    var currentId   = wrapper.dataset.currentId;
    var renderedIds = (wrapper.dataset.renderedIds || '').split(',').filter(Boolean);

    /* Filter: exclude current product, keep only IDs that were actually rendered */
    var viewedIds = getViewedIds()
      .map(function (id) { return String(id); })
      .filter(function (id) {
        return id !== String(currentId) && renderedIds.includes(id);
      })
      .slice(0, MAX_SHOW);

    /* Nothing to show → hide entire section */
    if (viewedIds.length === 0) {
      wrapper.style.display = 'none';
      return;
    }

    var grid    = wrapper.querySelector('.rv-grid');
    var heading = wrapper.querySelector('.rv-heading');
    var allCards = wrapper.querySelectorAll('.rv-card');
    var cardMap  = {};

    /* Build a map of productId → card element for O(1) lookup */
    allCards.forEach(function (card) {
      cardMap[card.dataset.productId] = card;
    });

    /* Show cards in recency order */
    var shown = 0;
    viewedIds.forEach(function (id) {
      if (shown >= MAX_SHOW) return;
      var card = cardMap[id];
      if (card) {
        card.classList.remove('rv-hidden');
        shown++;
      }
    });

    if (shown === 0) {
      wrapper.style.display = 'none';
      return;
    }

    /* Reveal grid and heading */
    grid.classList.remove('rv-hidden');
    heading.classList.remove('rv-hidden');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% stylesheet %}
  /* Hidden state — used by JS to show/hide cards, heading, and grid */
  .rv-hidden {
    display: none !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recently Viewed",
  "tag": "div",
  "class": "section-wrapper",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    { "type": "text"   },
    { "type": "button" },
    { "type": "@theme" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Column gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Row gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Inner gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed",
      "category": "Products",
      "settings": {
        "columns": 5,
        "mobile_columns": "2",
        "columns_gap": 12,
        "rows_gap": 16,
        "section_width": "page-width",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    }
  ]
}
{% endschema %}
