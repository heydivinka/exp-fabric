{% doc %}
  @prompt
    A store card location with store name, address, city/country, and contact icon with url handle
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-store-card-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.shadow_enabled | default: false }};
  }

  .ai-store-card-{{ ai_gen_id }}.shadow-enabled {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-store-card-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-store-card-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-store-card-address-{{ ai_gen_id }} {
    font-size: {{ block.settings.address_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-store-card-city-{{ ai_gen_id }} {
    font-size: {{ block.settings.city_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-store-card-contacts-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.icon_spacing }}px;
    margin-top: {{ block.settings.contact_margin_top }}px;
  }

  .ai-store-card-contact-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    color: {{ block.settings.icon_color }};
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-store-card-contact-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.icon_hover_background }};
    color: {{ block.settings.icon_hover_color }};
    transform: translateY(-2px);
  }

  .ai-store-card-contact-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
  }

  @media screen and (max-width: 749px) {
    .ai-store-card-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<store-location-card-{{ ai_gen_id }} class="ai-store-card-{{ ai_gen_id }} {% if block.settings.shadow_enabled %}shadow-enabled{% endif %}" {{ block.shopify_attributes }}>
  <div class="ai-store-card-content-{{ ai_gen_id }}">
    {% if block.settings.store_name != blank %}
      <h3 class="ai-store-card-name-{{ ai_gen_id }}">{{ block.settings.store_name }}</h3>
    {% endif %}

    {% if block.settings.address != blank %}
      <p class="ai-store-card-address-{{ ai_gen_id }}">{{ block.settings.address }}</p>
    {% endif %}

    {% if block.settings.city_country != blank %}
      <p class="ai-store-card-city-{{ ai_gen_id }}">{{ block.settings.city_country }}</p>
    {% endif %}

    <div class="ai-store-card-contacts-{{ ai_gen_id }}">
      {% if block.settings.phone_url != blank %}
        <a 
          href="{{ block.settings.phone_url }}" 
          class="ai-store-card-contact-{{ ai_gen_id }}"
          aria-label="Call store"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.email_url != blank %}
        <a 
          href="{{ block.settings.email_url }}" 
          class="ai-store-card-contact-{{ ai_gen_id }}"
          aria-label="Email store"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.website_url != blank %}
        <a 
          href="{{ block.settings.website_url }}" 
          class="ai-store-card-contact-{{ ai_gen_id }}"
          aria-label="Visit website"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.directions_url != blank %}
        <a 
          href="{{ block.settings.directions_url }}" 
          class="ai-store-card-contact-{{ ai_gen_id }}"
          aria-label="Get directions"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</store-location-card-{{ ai_gen_id }}>

<script>
  (function() {
    class StoreLocationCard{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const links = this.querySelectorAll('.ai-store-card-contact-{{ ai_gen_id }}');
        links.forEach(link => {
          link.addEventListener('focus', function() {
            this.style.outline = '2px solid currentColor';
            this.style.outlineOffset = '2px';
          });
          link.addEventListener('blur', function() {
            this.style.outline = '';
            this.style.outlineOffset = '';
          });
        });
      }
    }

    customElements.define('store-location-card-{{ ai_gen_id }}', StoreLocationCard{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Store location card",
  "settings": [
    {
      "type": "header",
      "content": "Store information"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store name",
      "default": "Downtown Store"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "123 Main Street, Suite 100"
    },
    {
      "type": "text",
      "id": "city_country",
      "label": "City and country",
      "default": "New York, USA"
    },
    {
      "type": "header",
      "content": "Contact links"
    },
    {
      "type": "url",
      "id": "phone_url",
      "label": "Phone URL"
    },
    {
      "type": "url",
      "id": "email_url",
      "label": "Email URL"
    },
    {
      "type": "url",
      "id": "website_url",
      "label": "Website URL"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Directions URL"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "shadow_enabled",
      "label": "Enable shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "content_spacing",
      "label": "Content spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Store name size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "address_size",
      "label": "Address size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "city_size",
      "label": "City size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Contact icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Icon spacing",
      "min": 5,
      "max": 20,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "contact_margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "icon_border_radius",
      "label": "Icon border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_hover_background",
      "label": "Icon hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "icon_hover_color",
      "label": "Icon hover color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Store location card"
    }
  ]
}
{% endschema %}
